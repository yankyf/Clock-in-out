{
  "name": "@clock/desktop",
  "version": "0.1.0",
  "description": "Offline-first clock in/out desktop client.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || true"
  },
  "dependencies": {
    "@clock/shared": "*",
    "better-sqlite3": "^11.1.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "electron": "^31.3.0",
    "typescript": "^5.5.4"
  }
}
