# Copy to .env and adjust.

# Dev: SQLite file (zero setup). For production, use Postgres, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/clockinout?schema=public"
DATABASE_URL="file:./dev.db"

# Sign JWTs. CHANGE THIS to a long random string in production.
JWT_SECRET="dev-only-change-me"

# Seed credentials for the initial OWNER account (used by `npm run seed`).
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="changeme123"
SEED_OWNER_NAME="Owner"

PORT=4000
